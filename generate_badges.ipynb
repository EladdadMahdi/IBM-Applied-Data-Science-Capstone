# Cellule 1 (exécuter une fois)
pkgs = ['scikit-learn', 'pandas', 'numpy', 'matplotlib', 'seaborn']
badges = []

for pkg in pkgs:
    try:
        ver = !pip show {pkg} | grep Version | cut -d: -f2 | xargs
        badges.append(f"![{pkg}](https://img.shields.io/badge/{pkg}-{ver.strip()}-blue)")
    except:
        pass

print("=== COPIEZ CES BADGES DANS VOTRE README.md ===")
for badge in badges:
    print(badge)
